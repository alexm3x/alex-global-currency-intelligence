{
  "name": "alex-global-currency-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:viajes:css",
    "build:viajes:css": "tailwindcss -c viajes/tailwind.config.cjs -i viajes/tailwind.input.css -o viajes/app.css --minify",
    "test": "node --test tests/*.test.mjs",
    "update:data": "node scripts/update-structural-data.mjs",
    "deploy": "npm test && wrangler deploy",
    "deploy:market": "npm test && wrangler deploy --config wrangler.market-data.jsonc",
    "deploy:equities": "npm test && wrangler deploy --config wrangler.equity-fundamentals.jsonc",
    "check": "npm test && wrangler deploy --dry-run && wrangler deploy --dry-run --config wrangler.market-data.jsonc && wrangler deploy --dry-run --config wrangler.equity-fundamentals.jsonc",
    "check:market": "npm test && wrangler deploy --dry-run --config wrangler.market-data.jsonc",
    "check:equities": "npm test && wrangler deploy --dry-run --config wrangler.equity-fundamentals.jsonc",
    "check:viajes-assistant": "npm test && wrangler deploy --dry-run --config wrangler.viajes-assistant.jsonc",
    "deploy:viajes-assistant": "npm test && wrangler deploy --config wrangler.viajes-assistant.jsonc"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.1",
    "wrangler": "^4.119.0"
  }
}
