{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agci-market-data",
  "main": "cloudflare/agci-market-data-live.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "triggers": {
    // Six credits or fewer per minute; Twelve Data Basic permits eight.
    "crons": ["0 */6 * * *", "2 */6 * * *", "4 */6 * * *"]
  },
  "kv_namespaces": [
    {
      // Durable last-known-good market snapshots for SWR fallback.
      "binding": "MARKET_DATA_CACHE"
    },
    {
      // Wrangler 4.119+ provisions this namespace automatically on first deploy.
      "binding": "TAIL_RISK_STATE"
    }
  ],
  "secrets": {
    "required": ["TWELVE_DATA_API_KEY", "AGCI_TAIL_RISK_API_KEY"]
  },
  "vars": {
    "TAIL_RISK_ENABLED": "true",
    "TAIL_RISK_CHANNELS": "telegram,discord,slack",
    "TAIL_RISK_HISTORY_LIMIT": "64",
    "TAIL_RISK_MIN_SAMPLES": "6",
    "TAIL_RISK_THRESHOLD_PERCENT": "15",
    "TAIL_RISK_MIN_SCORE_POINTS": "5",
    "TAIL_RISK_PRICE_WEIGHT": "0.65",
    "TAIL_RISK_MOMENTUM_WEIGHT": "0.35"
  }
}
